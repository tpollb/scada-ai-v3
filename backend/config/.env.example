# App
DEBUG=false
HOST=0.0.0.0
PORT=8081

# SCADA
SCADA_BASE_URL=http://localhost:9002
SCADA_USERNAME=admin
SCADA_PASSWORD=secret
SCADA_POLL_INTERVAL=5

# Database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/scada

# Redis
REDIS_URL=redis://localhost:6379/0

# YandexGPT
YANDEX_API_KEY=your-api-key-here
YANDEX_FOLDER_ID=your-folder-id-here
YANDEX_GPT_MODEL=yandexgpt/latest
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=30

# Auth
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Modules
ENABLED_MODULES=["hello", "health", "schedules"]
